# PostHog EU (personal-web project, id 192845). Client-safe; used in the browser bundle.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Set only after verifying the project retention in PostHog and updating /integritet.
# Analytics stays paused when this is absent.
VITE_PUBLIC_POSTHOG_RETENTION_MONTHS=

# AI tutor (off unless set; see docs/medborgarskap-tutor-operations.md). Server-side values are
# never VITE_ prefixed and must not reach the browser bundle.
# VITE_PUBLIC_TUTOR_ENABLED=
# OPENAI_API_KEY=
# OPENAI_TUTOR_ENABLED=
# OPENAI_TUTOR_MODEL=
# OPENAI_TUTOR_LOCAL_REVIEW=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# TUTOR_DAILY_BUDGET_MICRO_USD=
# TUTOR_MONTHLY_BUDGET_MICRO_USD=
# TUTOR_SUBJECT_DAILY_REQUEST_LIMIT=
# TUTOR_RESERVATION_TTL_SECONDS=
