{
  "name": "medborgarskap",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "tsc": "tsc -b",
    "lint": "oxlint && node scripts/check-agent-scope.mjs",
    "lint:ci": "oxlint && node scripts/check-agent-scope.mjs",
    "check:agent-scope": "node scripts/check-agent-scope.mjs",
    "check:route-meta": "node scripts/check-route-meta.mjs",
    "check:all": "npm run verify && npm run check:quotes && node scripts/run-browser-checks.mjs",
    "verify": "npm run tsc && npm run tsc:api && npm run check:mcp-node-runtime && npm run lint:ci && npm run check:route-meta && npm run test && npm run check:chatgpt-package && npm run build && npm run check:cascade && npm run check:og-preview",
    "record:og-preview": "node scripts/record-og-preview-video.mjs",
    "check:og-preview": "node scripts/check-og-preview-video.mjs",
    "check:og-preview-gates": "node scripts/og-preview/run-gate-regression.mjs",
    "check:cascade": "node scripts/check-layer-order.mjs --baseline grundform-unlayered-baseline.json dist",
    "preview": "vite preview",
    "test": "vitest run",
    "tsc:api": "tsc -p tsconfig.api.json",
    "test:a11y": "node scripts/a11y-axe.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:a11y:install-browser": "playwright install chromium",
    "test:grundform-contrast": "node scripts/grundform-contrast.mjs",
    "screenshots:a11y": "node scripts/a11y-screenshots.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:search": "node scripts/check-search-visibility.mjs",
    "check:chatgpt-package": "node scripts/check-chatgpt-package.mjs --draft",
    "package:chatgpt": "node scripts/package-chatgpt.mjs",
    "check:mcp": "node scripts/check-mcp.mjs",
    "check:mcp-node-runtime": "node scripts/check-mcp-node-runtime.mjs",
    "check:quotes": "node scripts/extract-pdf-text.mjs --out /tmp/sverige-i-fokus.pages.json && SOURCE_PDF_TEXT=/tmp/sverige-i-fokus.pages.json vitest run scripts/__tests__/quotes-pdf.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "posthog-js": "^1.434.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.55.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
